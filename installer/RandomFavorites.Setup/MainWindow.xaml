<Window x:Class="RandomFavorites.Setup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RandomFavorites"
        Icon="Assets/RandomFavorites.ico"
        Width="620"
        Height="390"
        MinWidth="560"
        MinHeight="360"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Background="{StaticResource WindowBackground}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="38" ResizeBorderThickness="5" CornerRadius="6" GlassFrameThickness="0" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="38" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#162422" BorderBrush="#29413D" BorderThickness="0,0,0,1">
            <Grid Margin="12,0,3,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="38" />
                    <ColumnDefinition Width="38" />
                    <ColumnDefinition Width="38" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="Assets/RandomFavorites.ico" Width="16" Height="16" Margin="0,0,8,0" />
                    <TextBlock Text="RandomFavorites" FontWeight="SemiBold" FontSize="11"
                               VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock x:Name="VersionText" Grid.Column="1" Text="Setup"
                           Foreground="{StaticResource TextMuted}" FontSize="9"
                           VerticalAlignment="Center" Margin="0,0,8,0" />

                <Button x:Name="MinimizeButton" Grid.Column="2" Content="&#x2014;"
                        Style="{StaticResource TitleBarButton}" FontSize="12"
                        WindowChrome.IsHitTestVisibleInChrome="True"
                        AutomationProperties.Name="Réduire" ToolTip="Réduire"
                        Click="MinimizeButton_OnClick" />
                <Button x:Name="MaximizeButton" Grid.Column="3" Content="&#x25A1;"
                        Style="{StaticResource TitleBarButton}" FontSize="14"
                        WindowChrome.IsHitTestVisibleInChrome="True"
                        AutomationProperties.Name="Agrandir" ToolTip="Agrandir"
                        Click="MaximizeButton_OnClick" />
                <Button x:Name="CloseButton" Grid.Column="4" Content="&#x00D7;"
                        Style="{StaticResource TitleBarButton}" FontSize="17"
                        WindowChrome.IsHitTestVisibleInChrome="True"
                        AutomationProperties.Name="Fermer" ToolTip="Fermer"
                        Click="CloseButton_OnClick" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" MaxWidth="500" Margin="28,22,28,18"
              HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="170" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="InstalledStatusText" Text="Vérification…"
                           FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"
                           Margin="0,0,18,0" TextTrimming="CharacterEllipsis" />

                <StackPanel Grid.Column="1">
                    <ComboBox x:Name="DiscordBranchCombo"
                              AutomationProperties.Name="Version de Discord"
                              DisplayMemberPath="DisplayName"
                              SelectionChanged="DiscordBranchCombo_OnSelectionChanged" />
                    <TextBlock x:Name="DiscordDetectionText" Text="Discord introuvable"
                               Visibility="Collapsed"
                               Foreground="{StaticResource TextMuted}" FontSize="9"
                               Margin="2,5,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="0,22,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="46" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="42" />
                </Grid.RowDefinitions>

                <Button x:Name="InstallButton" Content="Installer"
                        Style="{StaticResource ActionButton}" FontSize="12"
                        Click="InstallButton_OnClick" />

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="RepairButton" Content="Réparer"
                            Style="{StaticResource SecondaryButton}" FontSize="11"
                            Click="RepairButton_OnClick" />
                    <Button x:Name="UninstallButton" Grid.Column="2" Content="Désinstaller"
                            Style="{StaticResource SecondaryButton}" FontSize="11"
                            Click="UninstallButton_OnClick" />
                </Grid>
            </Grid>

            <TextBlock Grid.Row="2" Text="Discord restera fermé après l’opération."
                       Foreground="{StaticResource TextMuted}" FontSize="9"
                       Margin="2,10,0,0" />

            <Grid Grid.Row="3" Margin="0,12,0,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border x:Name="ResultPanel" Visibility="Collapsed" Background="#1C3932"
                        BorderBrush="#3A6C60" BorderThickness="1" CornerRadius="6"
                        Padding="10" Margin="0,0,0,7">
                    <StackPanel>
                        <TextBlock x:Name="ResultTitle" Text="Terminé" FontWeight="SemiBold"
                                   Foreground="{StaticResource Success}" FontSize="10" />
                        <TextBlock x:Name="ResultMessage" Foreground="{StaticResource TextSecondary}"
                                   TextWrapping="Wrap" Margin="0,2,0,0" FontSize="9" />
                    </StackPanel>
                </Border>

                <Expander x:Name="LogExpander" Grid.Row="1" Header="Journal"
                          Foreground="{StaticResource TextMuted}" IsExpanded="False" FontSize="9">
                    <Border Background="#101D1B" BorderBrush="#29443F" BorderThickness="1"
                            CornerRadius="5" Margin="0,5,0,0" Padding="8" MaxHeight="76">
                        <ScrollViewer x:Name="LogScrollViewer" VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="LogText" FontFamily="Cascadia Mono, Consolas" FontSize="8"
                                       Foreground="#86A09B" TextWrapping="Wrap" />
                        </ScrollViewer>
                    </Border>
                </Expander>
            </Grid>

            <StackPanel Grid.Row="4">
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="ProgressStageText" Text="Prêt" FontWeight="SemiBold" FontSize="9" />
                        <TextBlock x:Name="ProgressDetailText" Text=""
                                   Foreground="{StaticResource TextMuted}" FontSize="8" Margin="0,2,0,0"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button x:Name="CancelOperationButton" Grid.Column="1" Content="Annuler"
                            Visibility="Collapsed" Style="{StaticResource QuietButton}"
                            Padding="10,4" MinWidth="0" Click="CancelOperationButton_OnClick" />
                </Grid>
                <ProgressBar x:Name="OperationProgress" Minimum="0" Maximum="100" Value="0" />
            </StackPanel>
        </Grid>

        <Grid x:Name="UninstallOverlay" Grid.Row="1" Visibility="Collapsed" Background="#E6142321">
            <Border Width="440" Background="{StaticResource CardBackground}" CornerRadius="8" Padding="20"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    BorderBrush="{StaticResource Border}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Désinstaller" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12" />

                    <RadioButton x:Name="RemovePluginOnlyRadio" Content="RandomFavorites uniquement"
                                 IsChecked="True" Checked="UninstallChoice_OnChecked" />
                    <CheckBox x:Name="RemovePluginSettingsCheck" Content="Supprimer aussi ses réglages"
                              Margin="26,-1,0,5" FontSize="9" />

                    <RadioButton x:Name="RemoveVencordKeepDataRadio" Content="Vencord, conserver les données"
                                 Checked="UninstallChoice_OnChecked" />
                    <RadioButton x:Name="RemoveEverythingRadio" Content="Vencord et toutes ses données"
                                 Foreground="{StaticResource Danger}" Checked="UninstallChoice_OnChecked" />
                    <CheckBox x:Name="DeleteDataAcknowledge" Visibility="Collapsed"
                              Content="Je confirme la suppression des données locales"
                              Margin="26,0,0,2" FontSize="9" Checked="DeleteDataAcknowledge_OnChanged"
                              Unchecked="DeleteDataAcknowledge_OnChanged" />

                    <TextBlock x:Name="UninstallExplanationText"
                               Text="Le plugin sera retiré. Vencord et ses réglages seront conservés."
                               Foreground="{StaticResource TextMuted}" FontSize="9"
                               TextWrapping="Wrap" Margin="0,10,0,14" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Annuler" Style="{StaticResource QuietButton}" Margin="0,0,8,0"
                                MinWidth="76" Padding="13,7" Click="CancelUninstallButton_OnClick" />
                        <Button x:Name="ConfirmUninstallButton" Content="Désinstaller"
                                Style="{StaticResource DangerButton}" MinWidth="96" Padding="13,7"
                                Click="ConfirmUninstallButton_OnClick" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
