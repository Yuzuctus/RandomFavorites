<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>embedded</DebugType>
    <AssemblyName>RandomFavoritesSetup</AssemblyName>
    <RootNamespace>RandomFavorites.Setup</RootNamespace>
    <ApplicationIcon>Assets\RandomFavorites.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\RandomFavorites.Setup.Core\RandomFavorites.Setup.Core.csproj" />
    <ProjectReference Include="..\RandomFavorites.Setup.Presentation\RandomFavorites.Setup.Presentation.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\RandomFavorites.ico" />
  </ItemGroup>
</Project>
