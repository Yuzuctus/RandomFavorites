<Window x:Class="RandomFavorites.Setup.Dialogs.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="À propos de RandomFavorites"
        Width="420" Height="330"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource WindowBackground}"
        AutomationProperties.Name="À propos de RandomFavorites"
        PreviewKeyDown="Dialog_OnPreviewKeyDown">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="58" ResizeBorderThickness="0" CornerRadius="10" GlassFrameThickness="0" />
    </WindowChrome.WindowChrome>
    <Border Background="{StaticResource WindowBackground}" BorderBrush="{StaticResource BorderStrong}"
            BorderThickness="1" CornerRadius="10" Padding="24,0,16,20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="58" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="À propos" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button HorizontalAlignment="Right" Style="{StaticResource TitleBarButton}"
                    AutomationProperties.Name="Fermer" Click="CloseButton_OnClick">
                <Path Width="12" Height="12" Stroke="{StaticResource TextSecondary}" StrokeThickness="1.7"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Data="{StaticResource CloseGeometry}" />
            </Button>
            <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,8,8,12">
                <StackPanel Orientation="Horizontal">
                    <Border Width="44" Height="44" CornerRadius="9" Background="{StaticResource Accent}">
                        <Path Width="22" Height="22" Fill="{StaticResource AccentInk}"
                              Data="{StaticResource StarGeometry}" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="RandomFavorites" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock x:Name="VersionText" Text="Version —" Style="{StaticResource SecondaryText}" />
                    </StackPanel>
                </StackPanel>
                <TextBlock Margin="0,18,0,0" Style="{StaticResource SecondaryText}" TextWrapping="Wrap"
                           Text="Installe une build Vencord vérifiée contenant RandomFavorites, avec OpenAsar en option. Aucun jeton Discord ni aucune télémétrie ne sont utilisés." />
            </StackPanel>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Projet GitHub" Style="{StaticResource QuietButton}"
                        Click="GitHubButton_OnClick" />
                <Button x:Name="CloseButton" Content="Fermer" Style="{StaticResource SecondaryButton}"
                        MinWidth="96" IsDefault="True" Click="CloseButton_OnClick" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
