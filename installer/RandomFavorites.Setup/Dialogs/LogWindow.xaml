<Window x:Class="RandomFavorites.Setup.Dialogs.LogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Journal RandomFavorites"
        Width="660" Height="460" MinWidth="520" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        Background="{StaticResource WindowBackground}"
        AutomationProperties.Name="Journal détaillé RandomFavorites"
        PreviewKeyDown="Window_OnPreviewKeyDown">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="58" ResizeBorderThickness="6" CornerRadius="10" GlassFrameThickness="0" />
    </WindowChrome.WindowChrome>
    <Border Background="{StaticResource WindowBackground}" BorderBrush="{StaticResource BorderStrong}"
            BorderThickness="1" CornerRadius="10" Padding="20,0,12,16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="58" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="Journal" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button HorizontalAlignment="Right" Style="{StaticResource TitleBarButton}"
                    AutomationProperties.Name="Fermer" Click="CloseButton_OnClick">
                <Path Width="12" Height="12" Stroke="{StaticResource TextSecondary}" StrokeThickness="1.7"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Data="{StaticResource CloseGeometry}" />
            </Button>
            <TextBox x:Name="LogTextBox" Grid.Row="1" Margin="0,6,8,12"
                     FontFamily="Cascadia Mono, Consolas" FontSize="13"
                     IsReadOnly="True" AcceptsReturn="True" AcceptsTab="True"
                     TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     AutomationProperties.Name="Contenu du journal" />
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Effacer" Style="{StaticResource QuietButton}"
                        AutomationProperties.HelpText="Efface uniquement l'affichage actuel."
                        Click="ClearButton_OnClick" />
                <Button x:Name="OpenFileButton" Content="Ouvrir le fichier"
                        Style="{StaticResource QuietButton}" Margin="4,0"
                        Click="OpenFileButton_OnClick" />
                <Button Content="Copier" Style="{StaticResource SecondaryButton}"
                        MinWidth="96" Click="CopyButton_OnClick" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
